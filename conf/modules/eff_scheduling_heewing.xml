<!DOCTYPE module SYSTEM "module.dtd">
<module name="eff_scheduling_heewing" dir="ctrl">
  <doc>
    <description>T
      The control effectiveness scheduler for the Heewing T1 Ranger VTOL
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="MATRIX_EFFICIENCIES">
        <dl_setting var="T1.lift_eff_mt" min="0" step="0.1" max="50.0" param="LIFT_EFF_MT" persistent="true"/>
        <dl_setting var="T1.thrust_eff_mt" min="0" step="0.1" max="50.0" param="THRUST_EFF_MT" persistent="true"/>
        <!--dl_setting var="T1.lift_eff_ml" min="0" step="0.1" max="50.0" param="LIFT_EFF_ML" persistent="true"/>
        <dl_setting var="T1.lift_eff_mr" min="0" step="0.1" max="50.0" param="LIFT_EFF_MR" persistent="true"/>
        <dl_setting var="T1.lift_eff_mb" min="0" step="0.1" max="50.0" param="LIFT_EFF_MB" persistent="true"/>
        <dl_setting var="T1.yaw_eff_mr" min="0" step="0.1" max="50.0" param="YAW_EFF_MR" persistent="true"/>
        <dl_setting var="T1.yaw_eff_ml" min="0" step="0.1" max="50.0" param="YAW_EFF_ML" persistent="true"/>
        <dl_setting var="T1.yaw_eff_rt" min="0" step="0.1" max="50.0" param="YAW_EFF_RT" persistent="true"/>
        <dl_setting var="T1.yaw_eff_lt" min="0" step="0.1" max="50.0" param="YAW_EFF_LT" persistent="true"/>
        <dl_setting var="T1.thrust_eff_ml" min="0" step="0.001" max="1.0" param="THRUST_EFF_ML" persistent="true"/>
        <dl_setting var="T1.thrust_eff_mr" min="0" step="0.001" max="1.0" param="THRUST_EFF_MR" persistent="true"/>
        <dl_setting var="T1.thrust_eff_lt" min="0" step="0.001" max="1.0" param="THRUST_EFF_LT" persistent="true"/>
        <dl_setting var="T1.thrust_eff_rt" min="0" step="0.001" max="1.0" param="THRUST_EFF_RT" persistent="true"/-->
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="eff_scheduling_heewing.h"/>
  </header>
  <init fun="eff_scheduling_heewing_init()"/>
  <periodic fun="eff_scheduling_heewing_periodic()"/>
  <makefile>
    <file name="eff_scheduling_heewing.c"/>
  </makefile>
</module>
