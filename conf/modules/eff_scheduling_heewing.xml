<!DOCTYPE module SYSTEM "module.dtd">
<module name="eff_scheduling_heewing" dir="ctrl">
  <doc>
    <description>T
      The control effectiveness scheduler for the Heewing T1 Ranger VTOL
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="MATRIX_EFFICIENCIES">
        <dl_setting var="T1.yaw_eff_mr"    min="0" step="0.01" max="10.0" param="YAW_EFF_MR" persistent="true"/>
        <dl_setting var="T1.yaw_eff_ml"    min="0" step="0.01" max="10.0" param="YAW_EFF_ML" persistent="true"/>
        <dl_setting var="T1.yaw_eff_td"    min="0" step="0.01" max="10.0" param="YAW_EFF_TD" persistent="true"/>
        <dl_setting var="T1.lift_eff_mr"   min="0" step="0.01" max="10.0" param="LIFT_EFF_MR" persistent="true"/>
        <dl_setting var="T1.lift_eff_ml"   min="0" step="0.01" max="10.0" param="LIFT_EFF_ML" persistent="true"/>
        <dl_setting var="T1.lift_eff_mb"   min="0" step="0.01" max="10.0" param="LIFT_EFF_MB" persistent="true"/>
        <dl_setting var="T1.lift_eff_mt"   min="0" step="0.01" max="10.0" param="LIFT_EFF_MT" persistent="true"/>
        <dl_setting var="T1.thrust_eff_mr" min="0" step="0.01" max="10.0" param="THRUST_EFF_MR" persistent="true"/>
        <dl_setting var="T1.thrust_eff_ml" min="0" step="0.01" max="10.0" param="THRUST_EFF_ML" persistent="true"/>
        <dl_setting var="T1.thrust_eff_mt" min="0" step="0.01" max="10.0" param="THRUST_EFF_MT" persistent="true"/>
      </dl_settings>
      <dl_settings NAME="WLS_WEIGHTS">
        <dl_setting var="T1.wls_roll"   min="0" step="100" max="3000.0" param="ESH_WLS_ROLL" persistent="true"/>
        <dl_setting var="T1.wls_pitch"  min="0" step="100" max="3000.0" param="ESH_WLS_PITCH" persistent="true"/>
        <dl_setting var="T1.wls_yaw"    min="0" step="10" max="100.0" param="ESH_WLS_YAW" persistent="true"/>
        <dl_setting var="T1.wls_lift"   min="0" step="50" max="500.0" param="ESH_WLS_LIFT" persistent="true"/>
        <dl_setting var="T1.wls_thrust" min="0" step="50" max="500.0" param="ESH_WLS_THRUST" persistent="true"/>
        <dl_setting var="T1.wls_motors" min="0" step="0.1" max="100.0" param="ESH_WLS_MOTORS" persistent="true"/>
        <dl_setting var="T1.wls_meant"  min="0" step="0.1" max="100.0" param="ESH_WLS_MEANT" persistent="true"/>
        <dl_setting var="T1.wls_tdiff"  min="0" step="0.1" max="100.0" param="ESH_WLS_TDIFF" persistent="true"/>
        <dl_setting var="T1.wls_gamma_sq"  min="1000" step="1000" max="1000000.0" param="ESH_WLS_TDIFF" persistent="true"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="eff_scheduling_heewing.h"/>
  </header>
  <init fun="eff_scheduling_heewing_init()"/>
  <periodic fun="eff_scheduling_heewing_periodic()"/>
  <makefile>
    <file name="eff_scheduling_heewing.c"/>
  </makefile>
</module>
